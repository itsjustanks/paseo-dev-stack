# ─────────────────────────────────────────────────────────────────────────────
# devstack configuration.  cp .env.example .env  and edit.
# .env is gitignored — it holds secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Paseo ───────────────────────────────────────────────────────────────────
# Password for the Paseo web UI / API / websocket. CHANGE THIS.
PASEO_PASSWORD=change-me-now

# Extra hostnames allowed to reach Paseo. IPs and localhost are allowed by
# default; a Cloudflare tunnel hostname MUST be listed here or the UI will
# refuse the connection. Comma-separated, leading dot = wildcard.
# e.g. PASEO_HOSTNAMES=paseo.example.com,.lan
PASEO_HOSTNAMES=

# Host port for Paseo. Bound to 127.0.0.1 by default (see compose) so the only
# public path is the Cloudflare tunnel.
PASEO_PORT=6767

# Host directory mounted at /workspace inside the container (your code).
WORKSPACE_DIR=./workspace

# ── 9router (AI model routing / multi-account) ──────────────────────────────
# Dashboard password. Upstream default is 123456 — change it.
NINEROUTER_PASSWORD=change-me-too
NINEROUTER_PORT=20128

# API key minted from the 9router dashboard (Keys → Default Key), pasted here.
# Leave blank on first boot: bring the stack up, open the dashboard, create the
# key, put it here, then `docker compose up -d` again.
# The URL is the in-network address — containers reach each other by service
# name, so this is correct as-is and does NOT change with the public hostname.
NINEROUTER_URL=http://9router:20128
NINEROUTER_KEY=

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Token from a remotely-managed tunnel (Zero Trust → Networks → Tunnels →
# Create → Docker; copy the token out of the shown command).
# Leave blank to run a QUICK tunnel instead (random *.trycloudflare.com URL,
# no account needed, no auth in front of it — dev only).
TUNNEL_TOKEN=

# ── Agent CLIs ──────────────────────────────────────────────────────────────
GH_TOKEN=
SUPABASE_ACCESS_TOKEN=
CURSOR_API_KEY=

# ── Memory guards ───────────────────────────────────────────────────────────
# Hard ceiling on the agent container. Turbopack is Rust, so its memory sits
# outside the V8 heap and NODE_OPTIONS cannot bound it — a cgroup limit is the
# only real cap. Leave 0 for unlimited, or set e.g. 24g on a 32GB box to keep
# headroom for the host. Set both together (memswap = mem disables swap use).
PASEO_MEM_LIMIT=0
PASEO_MEMSWAP_LIMIT=0

# devserver-guard (host systemd timer, every 60s). Reaps Next dev servers that
# balloon, go stale, or are orphaned. Never touches Paseo/9router/agent CLIs.
# A first compile legitimately uses 6-11GB, so a cap below ~12 kills it
# mid-compile and looks like "next-server keeps crashing".
DEVSERVER_GUARD_MAX_GB=12.0
DEVSERVER_GUARD_MAX_AGE_H=2.0
DEVSERVER_GUARD_MAX_SERVERS=1
DEVSERVER_GUARD_MIN_AVAIL_GB=6.0

# ── Image build ─────────────────────────────────────────────────────────────
# Leave blank to install the latest release; set a version to pin.
SUPABASE_VERSION=
EXTRA_NPM_PACKAGES=
